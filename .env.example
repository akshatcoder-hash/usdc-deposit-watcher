# devnet or mainnet. One switch: it picks the endpoint and the USDC mint.
NETWORK=devnet

# Helius API key (dashboard.helius.dev). LaserStream devnet works on the plan you already have.
HELIUS_API_KEY=

# Wallet (owner address) whose USDC deposits you want to detect. A public address, never a private key.
WATCH_WALLET=

# finalized (default) credits only after finalization. confirmed credits earlier; see README.
COMMITMENT=finalized

# SQLite file
DB_PATH=./deposits.db
